ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=AIza-your-key-here

# GitHub OAuth (one-click "Connect GitHub Account" button)
# Register at github.com/settings/developers
# Add BOTH callback URLs to the OAuth App:
#   http://localhost:8501                  (local dev)
#   https://your-app.streamlit.app         (production)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# The URL this app is served at — used as the OAuth callback.
# Local default (can be omitted): http://localhost:8501
# On Streamlit Cloud, set this in App Secrets:
# APP_URL=https://your-app.streamlit.app
APP_URL=http://localhost:8501
